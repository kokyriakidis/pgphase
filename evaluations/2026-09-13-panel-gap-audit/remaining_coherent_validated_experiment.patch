+        profile.start_var_idx = 0; profile.end_var_idx = 3;
+        profile.alleles = alleles[ri];
+        chunk.read_var_profile.push_back(profile);
+        cr_add(chunk.read_var_cr.get(), "cr", 0, 4, ri);
+    }

+            var.key.ref_len = 1; var.key.alt = "T"; var.ref_base = 0;
+            var.key.type = vi == 2 ? VariantType::Insertion : VariantType::Snp;
+            var.lcd_var_i_to_cate = vi == 2 ? kCandNoisyCandHet : kCandCleanHetSnp;
+            var.is_homopolymer_indel = vi == 2;
+            var.hap_to_cons_alle = {{-1, 0, 1}};
+            var.counts.alle_covs = {8, 8}; var.counts.total_cov = 16;
+            var.counts.ref_cov = var.counts.alt_cov = 8;
+            var.counts.allele_fraction = 0.5; var.counts.n_uniq_alles = 2;
+            chunk.candidates.push_back(var);
+        }
+        chunk.read_var_cr.reset(cr_init());
+        for (int ri = 0; ri < 16; ++ri) {
+            const int allele = (ri / 2) % 2;
+            auto read = min_read();
+            read.mapq = 60;
+            read.alignment.reset(bam_init1());
+            const std::string sequence(1, allele == 0 ? 'A' : 'T');
+            const uint32_t cigar = bam_cigar_gen(1, BAM_CMATCH);
+            bam_set1(read.alignment.get(), 6, "anchor", 0, 0, 99, 60, 1, &cigar,
+                     -1, -1, 0, 1, sequence.c_str(), nullptr, 0);
+            bam_get_qual(read.alignment.get())[0] = mode == 1 || (mode == 3 && ri % 2) ? 10 : 40;
+            chunk.reads.push_back(std::move(read));
+            ReadVariantProfile profile;
+            profile.start_var_idx = 0; profile.end_var_idx = 2;
+            profile.alleles = {ri < 4 ? allele : -1, ri < 8 ? 0 : 1, allele};
+            if (mode == 2 && ri == 4) profile.alleles[0] = 1;
+            chunk.read_var_profile.push_back(profile);
+            cr_add(chunk.read_var_cr.get(), "cr", 0, 3, ri);
+        }
+        cr_index(chunk.read_var_cr.get());
+        Options opts;
+        opts.recover_gaps = opts.link_by_alleles = opts.private_msa_admit_all_in_region = true;
+        opts.min_block_link_reads = 2;
+        opts.gap_hp_link_beg = opts.gap_hp_link_end = 299;
+        assign_hap_based_on_germline_het_vars_kmeans(chunk, opts, kCandGermlineVarCate);
+        ok &= check(chunk.candidates[2].gap_link_supported == (mode == 0 || mode == 3),
+                    "an independent Q30 clean anchor can validate a repeat despite a noisy deeper anchor; low quality or conflicting evidence cannot");
+        if (mode == 0 || mode == 3)
+            ok &= check(chunk.candidates[2].hap_to_cons_alle[1] >= 0 &&
+                        chunk.candidates[2].hap_to_cons_alle[2] >= 0 &&
+                        chunk.candidates[2].hap_to_cons_alle[1] != chunk.candidates[2].hap_to_cons_alle[2],
+                        "k-means preserves both independently validated repeat alleles");
+    }
+    return ok;
+}

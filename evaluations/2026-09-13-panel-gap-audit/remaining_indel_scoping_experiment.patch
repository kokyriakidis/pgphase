+static bool test_msa_homozygous_consensus_keeps_reference_evidence() {
+    CandidateVariant var;
+    var.key.pos = 103; var.key.type = VariantType::Deletion; var.key.ref_len = 1;
+    var.counts.category = VariantCategory::NoisyCandHom;
+    var.counts.alle_covs = {0, 2}; var.counts.total_cov = 2;
+    var.counts.alt_cov = 2;
+    const auto reference = site_alignment("ACGATGC", "ACGATGC");
+    const auto deletion = site_alignment("ACGATGC", "ACG-TGC");
+    const std::array<AlnStr, 2> consensuses = {deletion, deletion};
+    std::vector<CandidateVariant> vars{var};
+    std::vector<ReadVariantProfile> profiles(4);
+    Options opts; opts.recover_gaps = opts.private_msa_admit_all_in_region = true;
+    add_msa_site_observations(opts, {{2, {reference, reference}}, {3, {reference, reference}}},
+                             100, false, vars, profiles, &consensuses);
+    return check(vars[0].counts.alle_covs == std::vector<int>({2, 2}) &&
+                 profiles[2].alleles == std::vector<int>({0}) &&
+                 profiles[3].alleles == std::vector<int>({0}),
+                 "matching provisional deletion consensuses cannot erase exact reference-supporting reads");
+}

+    std::vector<VariantCategory> categories;
+    std::vector<ReadVariantProfile> profiles;
+    make_vars_from_msa_cons_aln(opts, chunk, 2, {0, 1}, 100, 2,
+                               {1, 1}, {{{0}, {1}}}, alignments, vars, categories, profiles);
+    return check(vars.size() == 1 && vars[0].counts.alle_covs == std::vector<int>({1, 1}) &&
+                 profiles[0].alleles == std::vector<int>({0}) &&
+                 profiles[1].alleles == std::vector<int>({1}),
+                 "a partial MSA read covering the site and flanks votes its reference allele, not its ALT cluster");
+}

+static bool test_msa_insertion_homopolymer_encoding() {
+    PhasingChunk chunk;
+    chunk.ref_beg = 100; chunk.ref_seq = "ATTTTTG";
+    Options opts;
+    const auto is_hp = [&](hts_pos_t pos, const char* ref, const char* query) {
+        const auto aln = site_alignment(ref, query);
+        std::array<std::vector<AlnStr>, 2> alignments;
+        alignments[0] = {aln};
+        std::vector<CandidateVariant> vars;
+        std::vector<VariantCategory> categories;
+        std::vector<ReadVariantProfile> profiles;
+        make_vars_from_msa_cons_aln(opts, chunk, 0, {}, pos, 1, {0, 0}, {},
+                                   alignments, vars, categories, profiles);
+        return vars.size() == 1 && vars[0].is_homopolymer_indel;
+    };
+    bool ok = check(is_hp(101, "-TTTTT", "TTTTTT"),
+                    "insertion homopolymer detection compares reference and ALT in the same encoding");
+    chunk.ref_seq = "atttttg";
+    ok &= check(is_hp(101, "--TTTTT", "TTTTTTT") &&
+                !is_hp(101, "--TTTTT", "TATTTTT") &&
+                !is_hp(104, "-TTG", "TTTG") &&
+                !is_hp(99, "-ATTTTT", "TATTTTT"),
+                "homopolymer context is case-insensitive and requires covered reference bases");
+    return ok;
+}

# HG002 chr12 on CHM13 (scripts/dev/pg with PGDEV_PROFILE=chr12). Only full runs:
# there is no quick-tier region file for this chromosome.
PGDEV_CHROM=chr12
: "${PGDEV_CONTIG:=chr12}"
: "${PGDEV_REF:=${PGDEV_DATA}/chm13v2.0.chr12.renamed.fa}"
: "${PGDEV_BAM:=${PGDEV_DATA}/HG002_chr12_hifi_mapped_to_CHM13_chr12_annotated.bam}"
# The catalog names the contig CHM13#0#chr12; the reference and BAM name it chr12.
: "${PGDEV_SITES:=${PGDEV_DATA}/derived/chr12.sites.plain.vcf.gz}"
: "${PGDEV_GAF:=${PGDEV_DATA}/HG002.chr12.annotated.coord.gaf.gz}"
# Union of the per-read truth of every evaluated tool (parental truth BAM).
: "${PGDEV_TRUTH_READS:=${PGDEV_DATA}/derived/chr12_truth_hap.tsv}"
# Centromere / satellite array (approximate CHM13 coordinates).
: "${PGDEV_CEN:=34700000-37200000}"
PGDEV_EXCLUDE="${PGDEV_EXCLUDE-}"

# HG002 chr18 on CHM13 (scripts/dev/pg with PGDEV_PROFILE=chr18). Only full runs:
# there is no quick-tier region file for this chromosome.
PGDEV_CHROM=chr18
: "${PGDEV_CONTIG:=chr18}"
: "${PGDEV_REF:=${PGDEV_DATA}/chm13v2.0.chr18.renamed.fa}"
: "${PGDEV_BAM:=${PGDEV_DATA}/HG002_chr18_hifi_mapped_to_CHM13_chr18_annotated.bam}"
# The catalog names the contig CHM13#0#chr18; the reference and BAM name it chr18.
: "${PGDEV_SITES:=${PGDEV_DATA}/derived/chr18.sites.plain.vcf.gz}"
: "${PGDEV_GAF:=${PGDEV_DATA}/HG002.chr18.annotated.coord.gaf.gz}"
# Union of the per-read truth of every evaluated tool (parental truth BAM).
: "${PGDEV_TRUTH_READS:=${PGDEV_DATA}/derived/chr18_truth_hap.tsv}"
# Centromere / satellite array (approximate CHM13 coordinates).
: "${PGDEV_CEN:=15400000-20900000}"
PGDEV_EXCLUDE="${PGDEV_EXCLUDE-}"

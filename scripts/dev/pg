#!/usr/bin/env bash
# pgphase development loop. `scripts/dev/pg help` lists the commands.
set -euo pipefail

readonly here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=env.sh
source "${here}/env.sh"
readonly root="${PGDEV_ROOT}"
readonly runs="${PGDEV_STATE}/runs"
readonly unit_tests=(test_allele_identity test_graph_sites
                     test_graph_bam_adapter test_noise_filter test_union_phase test_phase_predicates)

die() { echo "pg: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: scripts/dev/pg COMMAND [TIER] [-- PGPHASE_ARGS...]

  test                 build pgphase and the unit tests (-j), run the unit and
                       predicate tests; prints one line per binary
  quick | full         run the tier with ./pgphase --bam (cached by binary and
                       arguments), score it, and compare with the pinned
                       baseline and the competitors
  same  [TIER]         is ./pgphase output-identical to the baseline? (refactors)
  diff  [TIER]         which arms_phaseable reads changed class vs the baseline
  switches [--all]     every arm switch (--all: and flip) of the full run against
                       the baseline: new, kept or gone, between which
                       truth-matched hets (scripts/dev/switches.py)
  pin   [TIER]         make ./pgphase's run the baseline for TIER
  pin-dir TIER DIR [--graph-only]
                       make an existing run directory the baseline for TIER
  path  [TIER]         print the run directory of ./pgphase for TIER
  diag                 full-tier run of ./pgphase with every diagnostic dump
                       (EM evidence, alignment candidates, noisy regions,
                       injection decisions, graph rows), cached per binary;
                       prints its directory
  inspect REGION [--all] [--reads N]
                       everything at REGION (chrN:A-B, A-B or a position):
                       reads of us and the competitors, noisy regions, and per
                       position truth, catalog, graph, alignment, injection,
                       EM and every tool's VCF (scripts/dev/inspect_region.py)
  gaps [--top N] [--out TSV]
                       gaps we leave that a competitor closes: unphased reads
                       it phases correctly, by locus, with our flanking blocks
                       and its phase set (scripts/dev/gapclose.py)
  funnel [--rival NAME] [--support N] [--out TSV]
                       where the pipeline loses the reads a competitor phases
                       correctly and we do not: by truth het, or by the
                       competitor's own phased sites; --support checks the
                       hets in the reads (scripts/dev/funnel.py)
  gapsites [--rival NAME] [--kind clean|all] [--top N] [--out TSV]
                       gaps a rival closes, each with the sites it uses there:
                       kind (snp / indel / str / hp), truth, our furthest
                       stage and why, and our calls on the gap reads
                       (scripts/dev/gapsites.py)
  each [-j N] CMD [ARGS]
                       run `pg CMD ARGS` for every profile in PGDEV_EACH
                       (default chr20 chr12 chr18), N at a time (default all),
                       each in its own environment; outputs in profile order
  sweep [-j N] CONFIG ...
                       CONFIG is LABEL or LABEL:VAR=VAL[,VAR=VAL...] (PGPHASE_*
                       variables); full tier of ./pgphase on every profile, then
                       per configuration each profile's change from its pinned
                       baseline (correct, discordant, unphased, switches) and
                       the total with its correct : discordant ratio
  islands [--worst N]  the union EM's island blocks in the diag run (run with
                       PGPHASE_ISLAND_MAX_ERR): per island its reads' classes,
                       truth at the site, parental purity of every read's call
                       there, and production-visible features, tallied against
                       truth (scripts/dev/islands.py)
  calls [--sites rejected|all]
                       accuracy of the EM's per-read calls (rejected sites by
                       default) by distance to the read end, labelled or not,
                       and repeat run: wrong % at truth hets, minority % where
                       there is none (scripts/dev/calls.py)
  hiphase-exact [--sites N] [--workers W]
                       HiPhase's own allele assignment (hiphase_port.py, a
                       line-for-line port of its global realignment, checked
                       by test_hiphase_port.py) on its own inputs, read by
                       read against our EM's calls at the rival's repeat het
                       indels, by truth and our EM state (scripts/dev/hiphase_exact.py)
  missing [--examples N]
                       truth het indels the rival calls and we have no EM site
                       for: where each is lost (MSA verdict, best injection
                       decision, EM) (scripts/dev/missing.py)
  noise [--rival NAME] [--examples N]
                       EM-reliable sites the parents do not split and the
                       discordant reads they label, by production feature
                       (--rival: only reads NAME phases correctly)
                       (scripts/dev/noise.py)
  lengthwin            the length windows (repeat loci genotyped from read
                       lengths) against truth: real het share and parental
                       purity by het score (scripts/dev/lengthwin.py)
  unphased [--loci N] [--list CAUSE]
                       every arms_phaseable read we leave unphased in one
                       primary cause (its calls judged by each parent's
                       allele), crossed with HiPhase's and LongPhase's class,
                       with the loci each cause concentrates in
                       (scripts/dev/unphased.py)
  audit [RIVAL] [--reads islands|FILE] [--list CLASS]
                       every read RIVAL (default hiphase) phases correctly and
                       we do not, unphased or discordant, in one primary cause
                       (repeat sites, low MAPQ, good site called / not called /
                       lost, rival without truth sites), discordant ones split
                       by their own calls; then every rival truth-het site in
                       those reads by kind, our stage and the read's call;
                       --reads restricts to island reads or a list of names
                       and crosses our classes with the rival's
                       (scripts/dev/readaudit.py)
  reads REGION [--rival NAME] [--missed]
                       every read at REGION against every truth het and rival
                       site: its allele in the alignment solve and in the EM
                       versus its truth haplotype (scripts/dev/locusreads.py)

TIER is quick (default) or full. quick runs the windows in
scripts/dev/quick_regions.bed (about 30 s); full runs the whole contig (about
2 min). Arguments after -- go to pgphase and are part of the cache key.
Environment: PGDEV_BIN overrides the binary; --graph-only drops --bam.
Paths come from scripts/dev/env.sh and scripts/dev/local.env.
EOF
}

py() { "${PGDEV_PYTHON}" -I "$@"; }

# Build TARGETS quietly; show compiler warnings from src/, and everything on failure.
build() {
    local log; log="$(mktemp)"
    if ! make -C "${root}" -s -j"${PGDEV_THREADS}" "${@:-pgphase}" > "${log}" 2>&1; then
        cat "${log}" >&2; rm -f "${log}"; die "build failed"
    fi
    grep -E "^src/.*warning:" "${log}" >&2 || true
    rm -f "${log}"
}

cmd_test() {
    local start=$SECONDS failed=0 t out
    build pgphase "${unit_tests[@]}"
    echo "build   $((SECONDS - start)) s"
    for t in "${unit_tests[@]}"; do
        if out=$(cd "${root}" && "./${t}" 2>&1); then
            printf "pass    %-24s %s\n" "${t}" "$(tail -1 <<<"${out}")"
        else
            printf "FAIL    %s\n%s\n" "${t}" "$(grep -E "FAIL|failed|Error" <<<"${out}" | head -20)"
            failed=1
        fi
    done
    echo "total   $((SECONDS - start)) s"
    return "${failed}"
}

# Positional state set by parse_tier.
tier=quick
graph_only=0
extra=()
parse_tier() {
    if [[ $# -gt 0 && "$1" != "--" ]]; then tier="$1"; shift; fi
    [[ "${tier}" == quick || "${tier}" == full ]] || die "unknown tier '${tier}'"
    [[ $# -gt 0 && "$1" == "--" ]] && shift
    for a in "$@"; do
        if [[ "${a}" == --graph-only ]]; then graph_only=1; else extra+=("${a}"); fi
    done
}

region_args() {
    [[ "${tier}" == full || -z "${PGDEV_PROFILE:-}" ]] || die "profile ${PGDEV_PROFILE} has no quick tier; use full"
    if [[ "${tier}" == full ]]; then
        echo "-r ${PGDEV_CONTIG}"
    else
        awk '!/^#/ && NF >= 3 {printf "-r %s:%d-%d ", $1, $2 + 1, $3}' "${here}/quick_regions.bed"
    fi
}

regions_bed() { [[ "${tier}" == quick ]] && echo "--regions ${here}/quick_regions.bed" || true; }

run_dir() {
    local bin="${PGDEV_BIN:-${root}/pgphase}" key
    key="$( { sha256sum "${bin}" | cut -c1-16; echo "${tier} ${graph_only} ${extra[*]:-}"; { env | grep "^PGPHASE_" | grep -v "^PGPHASE_\(TIMING\|EM_DUMP\|DIAG\)=" || true; } | sort; } | sha256sum | cut -c1-12)"
    echo "${runs}/${tier}-${key}"
}

# (Re)score DIR when it has no score, or the scorer or exclusions changed since.
ensure_score() {
    local dir="$1"
    if [[ ! -f "${dir}/score.json" || "${here}/score.py" -nt "${dir}/score.json" ||
          ( -n "${PGDEV_EXCLUDE}" && -f "${PGDEV_EXCLUDE}" && "${PGDEV_EXCLUDE}" -nt "${dir}/score.json" ) ]]; then
        # shellcheck disable=SC2046
        py "${here}/score.py" run "${dir}" $(regions_bed) --json "${dir}/score.json.tmp" >&2
        mv "${dir}/score.json.tmp" "${dir}/score.json"
    fi
}

# Run (or reuse) the tier for the binary; prints the run directory.
ensure_run() {
    local bin="${PGDEV_BIN:-${root}/pgphase}" dir tmp start bam_args=()
    dir="$(run_dir)"
    [[ -f "${dir}/meta.tsv" ]] && { ensure_score "${dir}"; echo "${dir}"; return; }
    if [[ "${tier}" == full && "${graph_only}" == 0 && ${#extra[@]} -eq 0 && -f "${dir}.diag/done" ]]; then
        adopt_diag "${dir}" "${dir}.diag" > /dev/null; echo "${dir}"; return
    fi
    [[ -n "${PGDEV_TRUTH_VCF}" ]] || die "set PGDEV_TRUTH_VCF (scripts/dev/local.env)"
    tmp="${dir}.tmp.$$"
    rm -rf "${tmp}"; mkdir -p "${tmp}"
    [[ "${graph_only}" == 1 ]] || bam_args=(--bam "${PGDEV_BAM}")
    start=$SECONDS
    # shellcheck disable=SC2046
    "${bin}" collect-graph-variation --ref "${PGDEV_REF}" "${bam_args[@]}" \
        --sites "${PGDEV_SITES}" --gaf "${PGDEV_GAF}" $(region_args) --threads "${PGDEV_THREADS}" \
        -o "${tmp}/candidates.tsv" --phased-vcf-out "${tmp}/phased.vcf" \
        --phased-bam-out "${tmp}/phased.bam" "${extra[@]}" > /dev/null 2> "${tmp}/stderr.log" \
        || { tail -20 "${tmp}/stderr.log" >&2; die "pgphase failed (log: ${tmp}/stderr.log)"; }
    local secs=$((SECONDS - start))
    {
        echo "binary	$(readlink -f "${bin}")"
        echo "sha256	$(sha256sum "${bin}" | cut -d' ' -f1)"
        echo "git	$(git -C "${root}" rev-parse --short HEAD 2>/dev/null)$(git -C "${root}" diff --quiet 2>/dev/null || echo "-dirty")"
        echo "tier	${tier}"
        echo "graph_only	${graph_only}"
        echo "args	${extra[*]:-}"
        echo "seconds	${secs}"
        echo "date	$(date -Is)"
    } > "${tmp}/meta.tsv"
    # shellcheck disable=SC2046
    py "${here}/score.py" run "${tmp}" $(regions_bed) --json "${tmp}/score.json"
    rm -rf "${dir}"; mv "${tmp}" "${dir}"
    echo "${dir}"
}

# Full-tier run with every diagnostic dump, next to the run's cache entry.
diag_dir() {
    tier=full
    local dir diag bin="${PGDEV_BIN:-${root}/pgphase}"
    [[ -n "${PGDEV_BIN:-}" ]] || build
    dir="$(run_dir)"; diag="${dir}.diag"
    if [[ ! -f "${diag}/done" ]]; then
        rm -rf "${diag}"; mkdir -p "${diag}/em" "${diag}/aln"
        echo "pg: diagnostic run of ${PGDEV_CONTIG} (about the time of a full run) -> ${diag}" >&2
        local start=$SECONDS
        PGPHASE_EM_DUMP="${diag}/em" PGPHASE_DIAG="${diag}/aln" \
        "${bin}" collect-graph-variation --ref "${PGDEV_REF}" --bam "${PGDEV_BAM}" \
            --sites "${PGDEV_SITES}" --gaf "${PGDEV_GAF}" -r "${PGDEV_CONTIG}" --threads "${PGDEV_THREADS}" \
            -o "${diag}/candidates.tsv" --phased-vcf-out "${diag}/phased.vcf" \
            --phased-bam-out "${diag}/phased.bam" > /dev/null 2> "${diag}/stderr.log" \
            || { tail -20 "${diag}/stderr.log" >&2; die "diagnostic run failed"; }
        echo "seconds	$((SECONDS - start))" > "${diag}/seconds"
        touch "${diag}/done"
    fi
    [[ -f "${dir}/meta.tsv" ]] || adopt_diag "${dir}" "${diag}" > /dev/null
    echo "${diag}"
}

# A diagnostic run is also the full run of its binary and environment (the
# dumps do not change the output): make DIR (the full run's cache entry) point
# at DIAG's outputs and score it, so neither is run twice.
adopt_diag() {
    local dir="$1" diag="$2" bin="${PGDEV_BIN:-${root}/pgphase}" tmp="$1.tmp.$$"
    rm -rf "${tmp}"; mkdir -p "${tmp}"
    ln -s "${diag}/phased.bam" "${tmp}/phased.bam"
    ln -s "${diag}/phased.vcf" "${tmp}/phased.vcf"
    {
        echo "binary	$(readlink -f "${bin}")"
        echo "sha256	$(sha256sum "${bin}" | cut -d' ' -f1)"
        echo "git	$(git -C "${root}" rev-parse --short HEAD 2>/dev/null)$(git -C "${root}" diff --quiet 2>/dev/null || echo "-dirty")"
        echo "tier	full"
        echo "graph_only	0"
        echo "args	"
        echo "seconds	$(awk -F'\t' '{print $2}' "${diag}/seconds" 2>/dev/null || echo 0)"
        echo "date	$(date -Is)"
        echo "from_diag	${diag}"
    } > "${tmp}/meta.tsv"
    py "${here}/score.py" run "${tmp}" --json "${tmp}/score.json"
    rm -rf "${dir}"; mv "${tmp}" "${dir}"
    echo "${dir}"
}

# Profiles `each` and `sweep` cover: names of scripts/dev/profiles/*.env, or
# the default contig's chromosome for the default profile.
: "${PGDEV_EACH:=chr20 chr12 chr18}"
profile_of() { [[ -f "${here}/profiles/$1.env" ]] && echo "$1" || echo ""; }
# Values env.sh derives per profile; a child for another profile must not inherit them.
readonly per_profile=(PGDEV_PROFILE PGDEV_CHROM PGDEV_STATE PGDEV_REF PGDEV_BAM PGDEV_SITES PGDEV_GAF
                      PGDEV_CONTIG PGDEV_TRUTH_READS PGDEV_TRUTH_VCF PGDEV_COMPETITORS PGDEV_EXCLUDE PGDEV_CEN)

# pg each [-j N] CMD ARGS: run `pg CMD ARGS` for every profile in PGDEV_EACH,
# N at a time (default all), each in its own environment; print the outputs in
# profile order. Builds once first so the children never build concurrently.
cmd_each() {
    local jobs=0 name i unset_args=() outs=() names=() failed=0
    if [[ "${1:-}" == -j ]]; then jobs="$2"; shift 2; fi
    [[ $# -ge 1 ]] || die "usage: pg each [-j N] CMD [ARGS]"
    [[ -z "${PGDEV_BIN:-}" ]] && build
    for v in "${per_profile[@]}"; do unset_args+=(-u "${v}"); done
    read -r -a names <<< "${PGDEV_EACH}"
    (( jobs > 0 )) || jobs=${#names[@]}
    for name in "${names[@]}"; do
        while (( $(jobs -rp | wc -l) >= jobs )); do wait -n || true; done
        outs+=("$(mktemp)")
        ( env "${unset_args[@]}" PGDEV_PROFILE="$(profile_of "${name}")" PGDEV_BIN="${PGDEV_BIN:-${root}/pgphase}" \
              "${here}/pg" "$@" > "${outs[-1]}" 2>&1 || echo "pg each: ${name} failed" >> "${outs[-1]}" ) &
    done
    wait
    for i in "${!names[@]}"; do
        echo "=== ${names[i]}"
        cat "${outs[i]}"
        grep -q "^pg each: .* failed$" "${outs[i]}" && failed=1
        rm -f "${outs[i]}"
    done
    return "${failed}"
}

# Internal: run (or reuse) the full tier and print "PROFILE BASELINE_JSON RUN_JSON".
cmd_score_paths() {
    tier=full
    local dir base=""
    dir="$(ensure_run)"
    base="$(baseline_dir 2>/dev/null)" && ensure_score "${base}" && base="${base}/score.json"
    echo "SCORE ${PGDEV_CHROM} ${base:--} ${dir}/score.json"
}

# pg sweep [-j N] CONFIG ...: each CONFIG is LABEL or LABEL:VAR=VAL[,VAR=VAL...]
# (PGPHASE_* environment for pgphase); runs the full tier of ./pgphase for every
# profile and prints, per configuration, each profile's change from its pinned
# baseline and the total.
cmd_sweep() {
    local jobs=() cfg label vars kv lines=()
    if [[ "${1:-}" == -j ]]; then jobs=(-j "$2"); shift 2; fi
    [[ $# -ge 1 ]] || set -- base
    [[ -z "${PGDEV_BIN:-}" ]] && build
    for cfg in "$@"; do
        label="${cfg%%:*}"; vars=""
        [[ "${cfg}" == *:* ]] && vars="${cfg#*:}"
        local envs=()
        if [[ -n "${vars}" ]]; then
            IFS=, read -r -a kvs <<< "${vars}"
            for kv in "${kvs[@]}"; do envs+=("${kv}"); done
        fi
        while read -r line; do lines+=("${label} ${line#SCORE }"); done < <(
            env "${envs[@]}" PGDEV_BIN="${PGDEV_BIN:-${root}/pgphase}" "${here}/pg" each "${jobs[@]}" score-paths | grep "^SCORE \|failed$")
    done
    printf '%s\n' "${lines[@]}" | py "${here}/sweep.py"
}

baseline_link() { echo "${PGDEV_STATE}/baseline-${tier}$([[ "${graph_only}" == 1 ]] && echo -graph)"; }

baseline_dir() {
    local link; link="$(baseline_link)"
    [[ -e "${link}" ]] || die "no baseline for ${tier}; run 'scripts/dev/pg pin ${tier}'"
    readlink -f "${link}"
}

# Score each competitor once per tier; cached by its file identity.
competitor_scores() {
    local pair name dir key out
    for pair in ${PGDEV_COMPETITORS}; do
        name="${pair%%=*}"; dir="${pair#*=}"
        key="$( { stat -c '%s %Y' "${dir}/phased.bam" "${dir}"/phased.vcf*; cat "${here}/score.py"; \
                  [[ -f "${PGDEV_EXCLUDE}" ]] && cat "${PGDEV_EXCLUDE}"; \
                  [[ "${tier}" == quick ]] && cat "${here}/quick_regions.bed"; } | sha256sum | cut -c1-12)"
        out="${PGDEV_CACHE}/competitors/${name}-${tier}-${key}.json"
        if [[ ! -f "${out}" ]]; then
            mkdir -p "$(dirname "${out}")"
            # shellcheck disable=SC2046
            py "${here}/score.py" run "${dir}" $(regions_bed) --json "${out}.tmp" && mv "${out}.tmp" "${out}"
        fi
        echo "${name}=${out}"
    done
}

cmd_eval() {
    parse_tier "$@"
    [[ -z "${PGDEV_BIN:-}" ]] && build
    local start=$SECONDS dir base names files pair
    dir="$(ensure_run)"
    echo "run      ${dir}  ($(awk -F'\t' '$1=="seconds" {print $2}' "${dir}/meta.tsv") s pgphase, $((SECONDS - start)) s total)"
    names="baseline,run"; files=()
    if base="$(baseline_dir 2>/dev/null)"; then
        ensure_score "${base}"
        files+=("${base}/score.json")
    else
        echo "(no baseline for ${tier}: 'scripts/dev/pg pin ${tier}' makes this run the baseline)"
        names="run"
    fi
    files+=("${dir}/score.json")
    for pair in $(competitor_scores); do names+=",${pair%%=*}"; files+=("${pair#*=}"); done
    echo
    py "${here}/score.py" table "${files[@]}" --names "${names}"
}

cmd_same() {
    parse_tier "$@"
    [[ -z "${PGDEV_BIN:-}" ]] && build
    local dir base
    dir="$(ensure_run)"; base="$(baseline_dir)"
    echo "run      ${dir}"; echo "baseline ${base}"
    if py "${here}/identity.py" "${base}" "${dir}"; then echo "SAME"; else echo "DIFFERENT"; return 1; fi
}

cmd_diff() {
    parse_tier "$@"
    [[ -z "${PGDEV_BIN:-}" ]] && build
    local dir base
    dir="$(ensure_run)"; base="$(baseline_dir)"
    # shellcheck disable=SC2046
    py "${here}/score.py" diff "${base}" "${dir}" $(regions_bed) --out "${dir}/changed_reads.tsv"
}

cmd_switches() {
    tier=full
    [[ -z "${PGDEV_BIN:-}" ]] && build
    local dir base
    dir="$(ensure_run)"; base="$(baseline_dir)"
    py "${here}/switches.py" "${dir}" "${base}" "$@"
}

cmd_pin() {
    parse_tier "$@"
    [[ -z "${PGDEV_BIN:-}" ]] && build
    local dir; dir="$(ensure_run)"
    ln -sfn "${dir}" "$(baseline_link)"
    echo "$(basename "$(baseline_link)") -> ${dir}"
}

cmd_pin_dir() {
    tier="$1"; local src; src="$(readlink -f "$2")"
    [[ "${3:-}" == --graph-only ]] && graph_only=1
    [[ -f "${src}/phased.bam" && -f "${src}/phased.vcf" ]] || die "${src} lacks phased.bam/phased.vcf"
    ensure_score "${src}"
    mkdir -p "${PGDEV_STATE}"
    ln -sfn "${src}" "$(baseline_link)"
    echo "$(basename "$(baseline_link)") -> ${src}"
}

main() {
    local cmd="${1:-help}"; shift || true
    mkdir -p "${runs}"
    case "${cmd}" in
        test) cmd_test ;;
        quick|full) cmd_eval "${cmd}" "$@" ;;
        same) cmd_same "$@" ;;
        diff) cmd_diff "$@" ;;
        switches) cmd_switches "$@" ;;
        pin) cmd_pin "$@" ;;
        pin-dir) [[ $# -ge 2 ]] || die "usage: pg pin-dir TIER DIR [--graph-only]"; cmd_pin_dir "$@" ;;
        path) parse_tier "$@"; run_dir ;;
        each) cmd_each "$@" ;;
        sweep) cmd_sweep "$@" ;;
        score-paths) cmd_score_paths ;;
        islands) local d; d="$(diag_dir)"; py "${here}/islands.py" "${d}" "$@" ;;
        calls) local d; d="$(diag_dir)"; py "${here}/calls.py" "${d}" "$@" ;;
        hiphase-exact) local d; d="$(diag_dir)"; py "${here}/hiphase_exact.py" "${d}" "$@" ;;
        missing) local d; d="$(diag_dir)"; py "${here}/missing.py" "${d}" "$@" ;;
        lengthwin) local d; d="$(diag_dir)"; py "${here}/lengthwin.py" "${d}" "$@" ;;
        noise) local d; d="$(diag_dir)"; py "${here}/noise.py" "${d}" "$@" ;;
        unphased) local d; d="$(diag_dir)"; py "${here}/unphased.py" "${d}" "$@" ;;
        diag) diag_dir ;;
        inspect) [[ $# -ge 1 ]] || die "usage: pg inspect REGION [--all] [--reads N]"
                 local d; d="$(diag_dir)"; py "${here}/inspect_region.py" "${d}" "$@" ;;
        funnel) local d; d="$(diag_dir)"; py "${here}/funnel.py" "${d}" "$@" ;;
        gaps) local d; d="$(diag_dir)"; py "${here}/gapclose.py" "${d}" "$@" ;;
        gapsites) local d; d="$(diag_dir)"; py "${here}/gapsites.py" "${d}" "$@" ;;
        audit) local d; d="$(diag_dir)"; py "${here}/readaudit.py" "${d}" "$@" ;;
        reads) [[ $# -ge 1 ]] || die "usage: pg reads REGION [--rival NAME] [--missed]"
               local d; d="$(diag_dir)"; py "${here}/locusreads.py" "${d}" "$@" ;;
        help|-h|--help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
